# --- Twilio (Console > Account > API keys & tokens) ---
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# TwiML App (Console > Voice > TwiML Apps) con Voice URL = https://PUBLIC_HOST/voice
TWILIO_TWIML_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Facoltativo: numero Twilio da usare come mittente. Se vuoto, il chiamato vede "client:<utente>"
TWILIO_CALLER_ID=

# --- Traduzione (DeepL API Free: la chiave finisce con :fx) ---
DEEPL_API_KEY=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx:fx

# --- Server ---
# Dominio pubblico HTTPS del server, senza https://
PUBLIC_HOST=call.workoftraduchat.it
PORT=3000

# Chiave condivisa per la demo (nell'app vera si usa il login Supabase)
DEMO_SECRET=cambia-questa-chiave

# Origini autorizzate a chiamare il server (separate da virgola)
ALLOWED_ORIGINS=https://traduchatchat.com,https://www.traduchatchat.com

# Verifica firma delle richieste Twilio (lascia true in produzione)
VALIDATE_TWILIO=true
